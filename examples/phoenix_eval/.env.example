# =============================================================================
# Phoenix Evaluation Example Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# All variables with (required) must be set. Others have sensible defaults.
# =============================================================================

# -----------------------------------------------------------------------------
# Kibana / Elasticsearch Connection (required)
# -----------------------------------------------------------------------------

# Kibana connector ID for LLM inference (required)
CONNECTOR_ID=your-connector-id

# Base64 encoded credentials for Kibana (required)
# Generate with: echo -n "user:password" | base64
KIBANA_AUTH=your-base64-encoded-credentials

# Kibana URL
KIBANA_URL=http://localhost:5601

# Evaluator connector ID (optional, uses CONNECTOR_ID if not set)
# EVALUATION_CONNECTOR_ID=your-evaluator-connector-id

# -----------------------------------------------------------------------------
# Phoenix Configuration
# -----------------------------------------------------------------------------

# Phoenix server URL
PHOENIX_BASE_URL=http://localhost:6006

# Phoenix API key (required for Phoenix Cloud, optional for local)
# PHOENIX_API_KEY=your-api-key

# Name of the dataset to load from Phoenix
PHOENIX_DATASET_NAME=my-rag-dataset

# Export experiment results to Phoenix Experiments UI (default: false)
# When enabled, evaluation results are synced to Phoenix for visualization
# ELASTIC_EVALS_PHOENIX_EXPERIMENT_EXPORT=true

# -----------------------------------------------------------------------------
# Elasticsearch for Exports and Traces
# -----------------------------------------------------------------------------

# Elasticsearch URL for exporting evaluation scores (optional)
# EVALUATIONS_ES_URL=http://localhost:9200

# Elasticsearch URL for trace data (required for trace-based evaluators)
# TRACE_ES_URL=http://localhost:9200

# -----------------------------------------------------------------------------
# Tracing Configuration
# -----------------------------------------------------------------------------

# Enable/disable tracing
ELASTIC_EVALS_TRACING_ENABLED=true

# Single exporter: otlp, phoenix, console, none
# ELASTIC_EVALS_TRACING_EXPORTER=otlp

# Multi-exporter: comma-separated list (otlp,phoenix)
# This sends traces to BOTH Elasticsearch APM and Phoenix
# ELASTIC_EVALS_TRACING_TARGETS=otlp,phoenix

# OTLP endpoint for Elasticsearch APM
ELASTIC_EVALS_TRACING_ENDPOINT=http://localhost:4318/v1/traces

# Phoenix collector endpoint (for tracing, not datasets)
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006

# Phoenix project name for traces
PHOENIX_PROJECT_NAME=phoenix-eval-example

# Use gRPC for Phoenix tracing (default: false, uses HTTP)
# ELASTIC_EVALS_PHOENIX_USE_GRPC=false

# Service name for traces
ELASTIC_EVALS_TRACING_SERVICE_NAME=elastic-evals

# -----------------------------------------------------------------------------
# Evaluation Settings
# -----------------------------------------------------------------------------

# Number of repetitions per example
ELASTIC_EVALS_REPETITIONS=3

# Concurrency level (parallel evaluations)
ELASTIC_EVALS_CONCURRENCY=5

# Log level: DEBUG, INFO, WARNING, ERROR
ELASTIC_EVALS_LOG_LEVEL=INFO

# Override run ID (optional, auto-generated if not set)
# ELASTIC_EVALS_RUN_ID=my-custom-run-id

# -----------------------------------------------------------------------------
# RAG Evaluation Settings
# -----------------------------------------------------------------------------

# Override K value for RAG metrics (Precision@K, Recall@K, F1@K)
# RAG_EVAL_K=5

# Restrict RAG evaluation to ground truth indices only
# INDEX_FOCUSED_RAG_EVAL=false

# -----------------------------------------------------------------------------
# Model Metadata (optional, for reporting)
# -----------------------------------------------------------------------------

# Model metadata as JSON
# ELASTIC_EVALS_MODEL={"id": "gpt-4", "family": "gpt", "provider": "openai"}
