# Eval runner environment for the chatbot-rag-app demo.
# Copy this file to .env.eval and edit CONNECTOR_ID:
#
#   cp .env.eval.example .env.eval

# Kibana (localhost with basic auth embedded in the URL)
KIBANA_URL=http://elastic:changeme@localhost:5601

# Connector ID — get this from Kibana > Stack Management > Connectors.
# In this example it is the LLM-as-a-judge connector used to score results.
# The system under test (the chatbot app) uses its own model configured in the
# chatbot's .env, so no separate task connector is needed here.
# (Set EVALUATION_CONNECTOR_ID only if you want a different model for scoring.)
CONNECTOR_ID=your-connector-id

# Suite ID — ties scores to this evaluation suite in the Evals UI.
ELASTIC_EVALS_SUITE_ID=chatbot-rag-eval-example

# Chatbot app URL (must match the port exposed by docker-compose.yml).
CHATBOT_APP_URL=http://localhost:4000

# Tracing (EDOT collector)
ELASTIC_EVALS_TRACING_ENABLED=true
ELASTIC_OTLP_ENDPOINT=http://localhost:4318
ELASTIC_EVALS_TRACING_SERVICE_NAME=elastic-evals

# Optional tuning
# ELASTIC_EVALS_REPETITIONS=1
# ELASTIC_EVALS_CONCURRENCY=5

# --- Secured / cloud alternative (use instead of basic-auth URL) ---
# KIBANA_URL=https://your-kibana
# KIBANA_API_KEY=
# ELASTIC_OTLP_API_KEY=
# ELASTICSEARCH_URL=http://localhost:9220
# ELASTICSEARCH_API_KEY=
