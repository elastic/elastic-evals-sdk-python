# Copy this file to .env and edit values for your environment.

# Location of the application routes.
FLASK_APP=api/app.py
# Ensure print statements appear as they happen.
PYTHONUNBUFFERED=1

# How you connect to Elasticsearch.
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=changeme

# Elasticsearch index names used by the app.
ES_INDEX=workplace-app-docs
ES_INDEX_CHAT_HISTORY=workplace-app-docs-chat-history

# Choose one provider by setting LLM_TYPE and uncommenting its keys.
LLM_TYPE=

# OpenAI (or a compatible API, override via base url change)
# LLM_TYPE=openai
# OPENAI_API_KEY=
# CHAT_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Azure OpenAI
# LLM_TYPE=azure
# AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE_NAME.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# OPENAI_API_VERSION=2024-10-01-preview
# CHAT_DEPLOYMENT=YOUR_DEPLOYMENT_NAME

# AWS Bedrock
# LLM_TYPE=bedrock
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=
# CHAT_MODEL=amazon.titan-text-lite-v1

# Google Vertex AI
# LLM_TYPE=vertex
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_REGION=
# CHAT_MODEL=gemini-1.5-flash-002
# GOOGLE_APPLICATION_CREDENTIALS=

# Mistral AI
# LLM_TYPE=mistral
# MISTRAL_API_KEY=
# CHAT_MODEL=open-mistral-nemo
# MISTRAL_BASE_URL=

# Cohere
# LLM_TYPE=cohere
# COHERE_API_KEY=
# CHAT_MODEL=command-r7b-12-2024

# Keep telemetry enabled so traces reach EDOT/Elasticsearch.
OTEL_SDK_DISABLED=false
OTEL_SERVICE_NAME=chatbot-rag-app
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=true

# Optional app URL for the eval task (consumed by the eval, not by the app).
# CHATBOT_APP_URL=http://localhost:4000
