{
  "_meta": {
    "description": "Wix Help-Center articles for user query resolution on services like web development and hosting."
  },
  "properties": {
    "id": {
      "type": "keyword",
      "meta": {
        "description": "Unique identifier for the knowledge article."
      }
    },
    "title": {
      "type": "text",
      "meta": {
        "description": "The title of the knowledge base article."
      },
      "copy_to": [
        "title_semantic_elser",
        "title_semantic_jina"
      ]
    },
    "title_semantic_elser": {
      "type": "semantic_text",
      "meta": {
        "description": "The title of the knowledge base article.",
        "use_case": "semantic search"
      }
    },
    "title_semantic_jina": {
      "type": "semantic_text",
      "inference_id": ".jina-embeddings-v3",
      "meta": {
        "description": "The title of the knowledge base article.",
        "use_case": "semantic search"
      }
    },
    "contents": {
      "type": "text",
      "meta": {
        "description": "The full text content of the knowledge article."
      },
      "copy_to": [
        "contents_semantic_elser",
        "contents_semantic_jina"
      ]
    },
    "contents_semantic_elser": {
      "type": "semantic_text",
      "meta": {
        "description": "The full text content of the knowledge article.",
        "use_case": "semantic search"
      }
    },
    "contents_semantic_jina": {
      "type": "semantic_text",
      "inference_id": ".jina-embeddings-v3",
      "meta": {
        "description": "The full text content of the knowledge article.",
        "use_case": "semantic search"
      }
    },
    "is_vetted": {
      "type": "keyword",
      "meta": {
        "description": "Is article vetted by experts (yes or no)."
      }
    }
  }
}
