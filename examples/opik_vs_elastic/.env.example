# Copy to .env and fill in your local values.
# Currently being used by notebooks under:
# -- examples/opik_vs_elastic/notebooks/

# Core local stack:
# Changed: added /dev base path (Kibana serves under it; missing prefix -> 404).
# KIBANA_URL=http://localhost:5601
KIBANA_URL=http://localhost:5601/dev
ES_URL=http://localhost:9200
ELASTICSEARCH_ENDPOINT="http://host.docker.internal:9200"
ELASTICSEARCH_API_KEY=<PLACEHOLDER>

# Vault:
VAULT_ADDR=https://secrets.elastic.co:8200

# Kibana auth (choose API key OR username/password):
# Changed: reuse the valid Elasticsearch API key (old key was invalid -> 401).
# KIBANA_API_KEY=<PLACEHOLDER>
KIBANA_API_KEY=<PLACEHOLDER>
KIBANA_USERNAME=elastic
KIBANA_PASSWORD=changeme
KIBANA_SPACE= # OR obs-ai OR DEFAULT
KIBANA_BASE_PATH= # Set when Kibana starts with a base path

# Agent Builder call parameters:
CONNECTOR_ID=gemini-25-flash  # eis-google-gemini-3-1-pro  # gemini-2.5-flash-preconfigured
EVALUATION_CONNECTOR_ID=gemini-25-pro  # eis-openai-gpt-5-4  # gemini-2.5-pro-preconfigured
AGENT_ID=wix-eval-agent

# Opik:
OPIK_API_KEY=<PLACEHOLDER>
OPIK_PROJECT_NAME=poc-evals-agent-builder  #context-engine-experiments
OPIK_WORKSPACE=context-and-research-playground  #agent-builder-data-science
OPIK_URL_OVERRIDE=https://www.comet.com/opik/api

# Optional for Orca LLM judges:
OPENROUTER_API_KEY=<PLACEHOLDER>
OPENROUTER_MODEL=openai/gpt-oss-120b:free

# LiteLLM
LITELLM_API_KEY=<PLACEHOLDER>
LITELLM_MODEL=azure_ai/Ministral-3B-20260324162715

# Hugging Face:
HUGGING_FACE_HUB_TOKEN=<PLACEHOLDER>
# Optional alias (some scripts use HF_TOKEN):
HF_TOKEN=<PLACEHOLDER>

# Tracing / Elastic evals:
TRACE_ES_URL=http://elastic:changeme@localhost:9200
ELASTIC_EVALS_TRACING_ENABLED=true
ELASTIC_EVALS_TRACING_EXPORTER=otlp
ELASTIC_EVALS_TRACING_ENDPOINT=http://localhost:4318/v1/traces
ELASTIC_EVALS_TRACING_SERVICE_NAME=elastic-evals

# ElasticEvals configs:
# ELASTIC_EVALS_RUN_ID=
ELASTIC_EVALS_REPETITIONS=1
ELASTIC_EVALS_CONCURRENCY=2
ELASTIC_EVALS_LOG_LEVEL=INFO
#ELASTIC_EVALS_SUITE_ID=
#ELASTIC_EVALS_MODEL=

